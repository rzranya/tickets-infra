.env
.env.*
!.env.example
node_modules/
.DS_Store
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
backups/

# Terraform — state and its backups can contain secret values (see
# modules/environment/secrets.tf's random_password resources), and
# .terraform/ is just downloaded provider binaries. terraform.lock.hcl is
# NOT ignored — that one should be committed (Terraform's own guidance).
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan
terraform/tfplan*.out
